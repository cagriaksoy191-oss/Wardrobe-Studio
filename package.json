{
  "name": "wardrobe-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:verify": "node scripts/verify-static-build.mjs",
    "deploy:check": "npm run build && npm run deploy:verify && wrangler deploy --dry-run",
    "deploy": "npm run build && npm run deploy:verify && wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.1.0",
    "fflate": "0.8.3",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "jspdf": "4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.176.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.3.0",
    "vitest": "^3.1.1",
    "wrangler": "4.160.0"
  }
}
